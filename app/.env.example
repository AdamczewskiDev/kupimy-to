# Supabase – tylko wartości do użytku w aplikacji (Expo).
# Skopiuj do .env i uzupełnij z https://supabase.com/dashboard (Project Settings → API).
# Nie wstawiaj tu hasła do bazy ani service_role key – tylko URL i anon key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Opcjonalnie: EAS Project ID (GUID z https://expo.dev → projekt → Settings).
# Potrzebne do powiadomień push (getExpoPushTokenAsync). Bez tego push nie będzie rejestrowany.
# EXPO_PUBLIC_EAS_PROJECT_ID=
